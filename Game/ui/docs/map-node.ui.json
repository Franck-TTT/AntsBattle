  "behaviour": "button",
  "properties": {
    "num": {
      "type": "number",
      "default": 1,
      "format": "value"
    },
    "stars": {
      "type": "number",
      "default": 0,
      "format": "value"
    },
    "state": {
      "type": "enum",
      "values": [
        "done",
        "current",
        "locked",
        "boss"
      ],
      "default": "done",
      "poses": {
        "current": {
          "set": {
            "mn_glow": {
              "tint": "#ffc93c99"
            },
            "mn_rim": {
              "tint": "#ffc93cff"
            },
            "mn_num": {
              "color": "#ffc93cff",
              "shadowColor": "#ffc93c33"
            },
            "root": {
              "scale": 1.25
            },
            "mn_stars": {
              "hide": true
            }
          }
        },
        "locked": {
          "set": {
            "mn_glow": {
              "hide": true
            },
            "mn_rim": {
              "tint": "#3b4049ff"
            },
            "mn_num": {
              "hide": true
            },
            "mn_lock": {
              "hide": false
            },
            "mn_stars": {
              "hide": true
            }
          }
        },
        "boss": {
          "set": {
            "mn_glow": {
              "hide": true
            },
            "mn_fill": {
              "hide": true
            },
            "mn_rim": {
              "hide": true
            },
            "mn_num": {
              "hide": true
            },
            "mn_stars": {
              "hide": true
            },
            "mn_oglow": {
              "hide": false
            },
            "mn_ofill": {
              "hide": false
            },
            "mn_orim": {
              "hide": false
            },
            "mn_core": {
              "hide": false
            },
            "root": {
              "scale": 1.35
            },
            "mn_corerim": {
              "hide": false
            }
          }
        }
      }
    }
  },
  "transition": {
    "type": "back",
    "ms": 240,
    "overshoot": 1.4
  },
  "states": {
    "pressed": {
      "set": {
        "root": {
          "scale": 0.94
        }
      }
    },
    "disabled": {
      "set": {
        "root": {
          "saturation": 0,
          "opacity": 0.6
        }
      }
    }
  }
}
