      "text": "{badge}",
      "style": {
        "fontSize": 32,
        "weight": 900,
        "color": "#05060fff",
        "font": {
          "guid": "45be2b88-6a50-4995-8bcb-b8615868b12a"
        }
      }
    },
    "nb_glow": {
      "type": "element",
      "name": "Element",
      "children": [],
      "style": {
        "pad": 0,
        "image": {
          "guid": "b78e6bfc-848b-4743-b864-ed94b96f5104"
        },
        "tint": "#ffc51fff",
        "tintMode": "multiply",
        "imageAlpha": 0.45,
        "position": "anchored",
        "anchor": [
          0.5,
          0.5
        ],
        "pivot": [
          0.5,
          0.5
        ],
        "attach": true,
        "w": "100%",
        "h": "100%",
        "sliceScale": 1,
        "hide": true
      }
    },
    "nb_lbl": {
      "type": "element",
      "name": "Element",
      "children": [
        "label",
        "nb_badge"
      ],
      "style": {
        "pad": 0
      }
    },
    "root_ring": {
      "type": "element",
      "name": "Element",
      "children": [],
      "style": {
        "pad": 0,
        "image": {
          "guid": "d6d43a9a-7808-494c-a48f-f370558cd9e0"
        },
        "sliceScale": 1,
        "tint": "#ffc51fff",
        "tintMode": "multiply",
        "position": "anchored",
        "anchor": [
          0.5,
          0.5
        ],
        "pivot": [
          0.5,
          0.5
        ],
        "attach": true,
        "w": "100%",
        "h": "100%",
        "hide": true
      }
    }
  },
  "behaviour": "button",
  "properties": {
    "label": {
      "type": "text",
      "default": "Button"
    },
    "icon": {
      "type": "image",
      "default": {
        "guid": "08280257-c237-4b96-83f3-e5146ed66ba4"
      }
    },
    "active": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "root": {
              "bg": "#00000000"
            },
            "nb_in": {
              "bg": "#1a1206ff"
            },
            "label": {
              "color": "#ffc51fff",
              "shadowColor": "#ffc51fb3",
              "shadowSoft": 10
            },
            "nb_icon": {
              "tint": "#ffc51fff"
            },
            "nb_glow": {
              "hide": false
            },
            "root_ring": {
              "hide": false
            }
          }
        }
      }
    },
    "badge": {
      "type": "text",
      "default": ""
    },
    "hasBadge": {
      "type": "yesno",
      "default": false
    }
  },
  "transition": {
    "type": "back",
    "ms": 240,
    "overshoot": 1.4
  },
  "states": {
    "pressed": {
      "set": {
        "root": {
          "scale": 0.94
        }
      }
    },
    "disabled": {
      "set": {
        "root": {
          "saturation": 0,
          "opacity": 0.6
        }
      }
    }
  }
}
