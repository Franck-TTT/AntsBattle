        "align": "center",
        "justify": "center",
        "bg": "#00000000",
        "radius": 40,
        "w": 0,
        "grow": 1
      },
      "children": [
        "nb_glow",
        "nb_in",
        "root_ring"
      ]
    },
    "label": {
      "type": "label",
      "name": "Label",
      "style": {
        "fontSize": 46,
        "fitMin": 24,
        "weight": 800,
        "color": "#9fb4ffff",
        "textAlign": "center",
        "shadowX": 0,
        "shadowY": 0,
        "shadowColor": "#00000000",
        "shadowSoft": 0,
        "font": {
          "guid": "95b2641e-e699-4217-9291-f759580ab645"
        }
      },
      "text": "Button",
      "property": "label"
    },
    "nb_in": {
      "type": "element",
      "name": "Element",
      "children": [
        "nb_icon",
        "nb_lbl"
      ],
      "style": {
        "pad": 0,
        "dir": "row",
        "align": "center",
        "justify": "center",
        "gap": 18,
        "w": "100%",
        "h": "100%",
        "radius": 40,
        "bg": "#00000000"
      }
    },
    "nb_icon": {
      "type": "element",
      "name": "Element",
      "children": [],
      "style": {
        "pad": 0,
        "image": "@icon",
        "w": 60,
        "h": 60,
        "tint": "#9fb4ffff",
        "tintMode": "multiply"
      }
    },
    "nb_badge": {
      "type": "element",
      "name": "Element",
      "children": [
        "nb_badge_t"
      ],
      "style": {
        "pad": 0,
        "position": "anchored",
        "anchor": [
          1,
          0
        ],
        "pivot": [
          0,
          0.5
