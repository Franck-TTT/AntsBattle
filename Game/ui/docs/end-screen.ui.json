{
  "$schemaVersion": 1,
  "guid": "29a570c4-dc46-47e7-8724-c75406b0c36d",
  "name": "end-screen",
  "title": "End screen",
  "kind": "view",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "End screen",
      "style": {
        "w": "100%",
        "h": "100%",
        "pad": 40,
        "justify": "center",
        "align": "center"
      },
      "children": [
        "es_panel"
      ]
    },
    "es_panel": {
      "type": "element",
      "name": "Element",
      "children": [
        "es_title",
        "es_sub",
        "end_restartbutton"
      ],
      "style": {
        "pad": [
          60,
          60,
          70,
          60
        ],
        "dir": "column",
        "align": "center",
        "bg": "#1a1220f2",
        "radius": 56,
        "gap": 26,
        "w": 900,
        "maxW": "100%"
      }
    },
    "es_title": {
      "type": "label",
      "name": "Label",
      "text": "{title}",
      "style": {
        "fontSize": 120,
        "fitMin": 60,
        "weight": 900,
        "color": "#ffc51fff",
        "outline": 6,
        "outlineColor": "#000000cc"
      }
    },
    "es_sub": {
      "type": "label",
      "name": "Label",
      "text": "{subtitle}",
      "style": {
        "fontSize": 44,
        "fitMin": 24,
        "weight": 700,
        "color": "#ffffffdd",
        "textAlign": "center"
      }
    },
    "end_restartbutton": {
      "type": "use",
      "doc": "restart-button",
      "key": "restart",
      "props": {
        "label": "PLAY AGAIN"
      }
    }
  },
  "view": {
    "behaviour": "dialog",
    "dims": true,
    "enter": {
      "set": {},
      "tracks": {
        "es_panel": {
          "keys": [
            {
              "at": 0,
              "set": {
                "scale": 0.5,
                "opacity": 0
              },
              "ease": "smooth"
            },
            {
              "at": 0.6,
              "set": {
                "scale": 1.06,
                "opacity": 1
              },
              "ease": "smooth"
            },
            {
              "at": 0.8,
              "set": {
                "scale": 0.98
              },
              "ease": "smooth"
            }
          ],
          "transition": {
            "type": "linear",
            "ms": 480
          }
        }
      },
      "lockInput": 350
    }
  },
  "properties": {
    "result": {
      "type": "enum",
      "values": [
        "won",
        "lost"
      ],
      "default": "won",
      "poses": {
        "lost": {
          "set": {
            "es_panel": {
              "bg": "#2a0d12f2"
            },
            "es_title": {
              "color": "#ff4d4dff"
            }
          }
        }
      }
    },
    "title": {
      "type": "text",
      "default": "VICTORY!"
    },
    "subtitle": {
      "type": "text",
      "default": "All 10 waves held"
    }
  },
  "samples": {
    "won": {
      "result": "won",
      "title": "VICTORY!",
      "subtitle": "All 10 waves held - 3 lives left"
    },
    "lost": {
      "result": "lost",
      "title": "OVERRUN",
      "subtitle": "They reached wave 6"
    }
  }
}
