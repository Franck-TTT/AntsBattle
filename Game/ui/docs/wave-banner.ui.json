{
  "$schemaVersion": 1,
  "guid": "c4fb3a6d-0f8c-41cc-adfb-7405ae300673",
  "name": "wave-banner",
  "title": "Wave banner",
  "kind": "view",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Wave banner",
      "style": {
        "w": "100%",
        "h": "100%",
        "pad": 0,
        "justify": "center",
        "align": "center"
      },
      "children": [
        "wb_panel"
      ]
    },
    "wb_panel": {
      "type": "element",
      "name": "Element",
      "children": [
        "wb_title",
        "wb_sub"
      ],
      "style": {
        "pad": [
          26,
          70,
          26,
          70
        ],
        "dir": "column",
        "align": "center",
        "bg": "#1a1220e6",
        "radius": 40,
        "gap": 2,
        "margin": [
          0,
          0,
          360,
          0
        ]
      }
    },
    "wb_title": {
      "type": "label",
      "name": "Label",
      "text": "{title}",
      "style": {
        "fontSize": 110,
        "fitMin": 60,
        "weight": 900,
        "color": "#ffc51fff",
        "outline": 6,
        "outlineColor": "#000000cc"
      }
    },
    "wb_sub": {
      "type": "label",
      "name": "Label",
      "text": "{subtitle}",
      "style": {
        "fontSize": 40,
        "fitMin": 24,
        "weight": 700,
        "color": "#ffffffdd"
      }
    }
  },
  "view": {
    "behaviour": "none",
    "enter": {
      "set": {},
      "tracks": {
        "wb_panel": {
          "keys": [
            {
              "at": 0,
              "set": {
                "scale": 0.4,
                "opacity": 0
              },
              "ease": "smooth"
            },
            {
              "at": 0.6,
              "set": {
                "scale": 1.12,
                "opacity": 1
              },
              "ease": "smooth"
            },
            {
              "at": 0.8,
              "set": {
                "scale": 0.96
              },
              "ease": "smooth"
            }
          ],
          "transition": {
            "type": "linear",
            "ms": 420
          }
        }
      }
    },
    "exit": {
      "set": {
        "root": {
          "opacity": 0,
          "ty": -60
        }
      },
      "transition": {
        "type": "easeInOut",
        "ms": 260
      }
    }
  },
  "properties": {
    "title": {
      "type": "text",
      "default": "WAVE 1"
    },
    "subtitle": {
      "type": "text",
      "default": "Here they come"
    },
    "tone": {
      "type": "enum",
      "values": [
        "normal",
        "boss"
      ],
      "default": "normal",
      "poses": {
        "boss": {
          "set": {
            "wb_panel": {
              "bg": "#7a0d1ef0"
            },
            "wb_title": {
              "color": "#ffffffff"
            }
          }
        }
      }
    }
  },
  "samples": {
    "normal": {
      "title": "WAVE 4",
      "subtitle": "Here they come",
      "tone": "normal"
    },
    "boss": {
      "title": "BOSS!",
      "subtitle": "Wave 10 - hold the line",
      "tone": "boss"
    }
  }
}
