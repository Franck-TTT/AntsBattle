            "label": {
              "color": "#ffffffff"
            }
          },
          "transition": {
            "type": "easeOut",
            "ms": 70
          }
        }
      }
    },
    "lean": {
      "type": "enum",
      "values": [
        "none",
        "left",
        "right",
        "up",
        "down"
      ],
      "default": "none",
      "poses": {
        "none": {
          "set": {
            "root": {
              "tx": 0,
              "ty": 0
            }
          },
          "transition": {
            "type": "instant"
          }
        },
        "left": {
          "set": {
            "root": {
              "tx": -14
            }
          },
          "transition": {
            "type": "easeOut",
            "ms": 350
          }
        },
        "right": {
          "set": {
            "root": {
              "tx": 14
            }
